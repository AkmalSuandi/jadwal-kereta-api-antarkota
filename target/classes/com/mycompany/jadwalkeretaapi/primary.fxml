      <!-- Area Output (Simetris Sempurna dengan layar lebar 583) -->
      <TextArea fx:id="areaOutput" layoutX="10.0" layoutY="330.0" prefHeight="205.0" prefWidth="563.0" />
   </children>
</AnchorPane>
