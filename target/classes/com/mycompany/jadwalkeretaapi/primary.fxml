      <!-- Garis Putus-putus Penghubung Stasiun (Sejajar Vertikal & Horizontal) -->
      <Line endX="390.0" endY="95.0" startX="165.0" startY="95.0" stroke="#888888" strokeWidth="3.0" style="-fx-stroke-dash-array: 10 5;" />
      <Line endX="430.0" endY="175.0" startX="430.0" startY="110.0" stroke="#888888" strokeWidth="3.0" style="-fx-stroke-dash-array: 10 5;" />
      <Line endX="430.0" endY="275.0" startX="430.0" startY="205.0" stroke="#888888" strokeWidth="3.0" style="-fx-stroke-dash-array: 10 5;" />

      <!-- Tombol Stasiun (Titik Pusat Sejajar) -->
